# BotFather se milega: Telegram par @BotFather ko /newbot bhejo
BOT_TOKEN=

# Optional but recommended — YouTube VPS/cloud IPs ko block kar deta hai.
# Fix: Webshare par "Residential" proxy plan lo (NOT "Proxy Server" ya
# "Static Residential" — sirf rotating residential reliably kaam karta hai).
# Values yahan se milengi: https://dashboard.webshare.io/proxy/settings
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# --- RedNote (Xiaohongshu) transcription ---
# RedNote videos mein YouTube jaisa caption-fetch API nahi hai, isliye bot
# audio download karke local speech-to-text (faster-whisper) chalata hai.

# Filhaal sirf ek option hai: local_whisper (free). Baad mein paid API add
# karni ho to transcription/backends.py mein naya class likh ke yahan uska
# naam daal do — bot ka baaki code touch nahi karna padega.
TRANSCRIPTION_BACKEND=local_whisper

# faster-whisper model size: tiny, base, small, medium, large-v3
# (bigger = zyada accurate lekin slower + zyada RAM). "base" ek VPS/home
# server (no GPU) ke liye reasonable default hai.
WHISPER_MODEL_SIZE=base

# transcribe = jis language mein bola gaya hai wahi. translate = hamesha
# English output.
WHISPER_TASK=transcribe
